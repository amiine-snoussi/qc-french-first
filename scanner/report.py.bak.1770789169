from __future__ import annotations
import os, json
from datetime import datetime
from typing import Dict, Any, List
from jinja2 import Environment, FileSystemLoader, select_autoescape
from urllib.parse import urlparse

from .utils import ensure_dir
from .pairs import build_pairs

def _status_bucket(code: int | None) -> str:
    if code is None:
        return "none"
    try:
        c = int(code)
    except Exception:
        return "none"
    if 200 <= c < 300: return "2xx"
    if 300 <= c < 400: return "3xx"
    if 400 <= c < 500: return "4xx"
    if 500 <= c < 600: return "5xx"
    return "other"

def _path(url: str) -> str:
    try:
        p = urlparse(url).path or "/"
        return (p.rstrip("/") or "/")
    except Exception:
        return "/"

def _strip_lang(path: str) -> str:
    for pref in ("/fr-ca", "/fr", "/en-ca", "/en-us", "/en"):
        if path == pref:
            return "/"
        if path.startswith(pref + "/"):
            rest = path[len(pref):]
            return rest if rest.startswith("/") else "/" + rest
    return path

def render_report(base_url: str, findings: Dict[str, Any], scored: Dict[str, Any], artifacts_dir: str, cfg: Dict[str, Any]) -> str:
    env = Environment(
        loader=FileSystemLoader("templates"),
        autoescape=select_autoescape(["html"])
    )
    tpl = env.get_template("report.html")

    ensure_dir(artifacts_dir)

    pages = findings.get("pages", []) or []
    key_pages = findings.get("key_pages", {}) or {}
    platform = findings.get("platform", {}) or {}
    signals = findings.get("signals", {}) or {}

    # --- Force pairs computation (validation never lies) ---
    pairs = findings.get("pairs") or {}
    summary = (pairs.get("summary") or {}) if isinstance(pairs, dict) else {}
    if not summary or int(summary.get("total_pairs") or 0) == 0:
        pairs = build_pairs(pages, base_url)
        findings["pairs"] = pairs

    pair_rows = (pairs.get("rows") or [])
    pair_summary = (pairs.get("summary") or {})

    # map core path -> row
    pairs_map: Dict[str, Dict[str, Any]] = {}
    for r in pair_rows:
        pairs_map[r.get("path") or ""] = r

    # screenshot rel paths
    for p in pages:
        sp = p.get("screenshot_path")
        if sp and os.path.exists(sp):
            p["screenshot_rel"] = os.path.relpath(sp, artifacts_dir)
        else:
            p["screenshot_rel"] = None

    # attach pair info to key pages (fixes bogus FR counterpart)
    for kt, kp in list(key_pages.items()):
        try:
            u = kp.get("final_url") or kp.get("url")
            if not u:
                continue
            core = _strip_lang(_path(u))
            kp["core_path"] = core
            kp["pair"] = pairs_map.get(core)
        except Exception:
            kp["core_path"] = None
            kp["pair"] = None

    # stats for validation
    lang_counts = {"en":0, "fr":0, "unknown":0}
    status_counts = {"2xx":0, "3xx":0, "4xx":0, "5xx":0, "other":0, "none":0}
    for p in pages:
        lang = p.get("lang") or "unknown"
        if lang not in lang_counts:
            lang = "unknown"
        lang_counts[lang] += 1
        status_counts[_status_bucket(p.get("status"))] += 1

    fr_prefix_hits = 0
    for p in pages:
        u = p.get("final_url") or ""
        path = _path(u)
        if path == "/fr" or path.startswith("/fr/") or path == "/fr-ca" or path.startswith("/fr-ca/"):
            fr_prefix_hits += 1

    stats = {
        "pages_total": len(pages),
        "status": status_counts,
        "lang": lang_counts,
        "fr_prefix_pages": fr_prefix_hits,
        "pairs": pair_summary,
    }

    generated_at = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

    # diagnostics.json for deep validation
    diag = {
        "base_url": base_url,
        "generated_at": generated_at,
        "platform": platform,
        "signals": signals,
        "stats": stats,
        "score": scored,
        "pairs_sample": pair_rows[:80],
        "key_pages": {
            k: {
                "final_url": (v.get("final_url") if isinstance(v, dict) else None),
                "core_path": (v.get("core_path") if isinstance(v, dict) else None),
                "pair": (v.get("pair") if isinstance(v, dict) else None),
                "lang": (v.get("lang") if isinstance(v, dict) else None),
                "status": (v.get("status") if isinstance(v, dict) else None),
            }
            for k,v in key_pages.items()
        }
    }
    with open(os.path.join(artifacts_dir, "diagnostics.json"), "w", encoding="utf-8") as f:
        json.dump(diag, f, ensure_ascii=False, indent=2)

    html = tpl.render(
        base_url=base_url,
        platform=platform,
        scored=scored,
        signals=signals,
        pages=pages,
        key_pages=key_pages,
        stats=stats,
        pair_rows=pair_rows,
        pair_summary=pair_summary,
        generated_at=generated_at,
    )

    report_path = os.path.join(artifacts_dir, "report.html")
    with open(report_path, "w", encoding="utf-8") as f:
        f.write(html)

    return report_path
