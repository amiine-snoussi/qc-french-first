#!/usr/bin/env python3
import glob, json, sys
from urllib.parse import urlparse

def pick_latest(pattern: str) -> str | None:
    paths = sorted(glob.glob(pattern))
    return paths[-1] if paths else None

def main():
    if len(sys.argv) < 2:
        print("usage: python tools/validate_latest.py https://example.com/")
        sys.exit(2)

    base = sys.argv[1].strip()
    host = urlparse(base).netloc or base.replace("https://","").replace("http://","").split("/")[0]
    diag = pick_latest(f"runs/{host}/*/diagnostics.json")
    if not diag:
        print(f"[validate] No diagnostics found under runs/{host}/")
        sys.exit(1)

    d = json.load(open(diag, "r", encoding="utf-8"))
    s = d.get("stats", {})
    pairs = s.get("pairs", {})
    lang = s.get("lang", {})
    status = s.get("status", {})

    print(f"[validate] diagnostics: {diag}")
    print(f"[validate] pages_total={s.get('pages_total')}")
    print(f"[validate] status: 2xx={status.get('2xx',0)} 3xx={status.get('3xx',0)} 4xx={status.get('4xx',0)} 5xx={status.get('5xx',0)} other={status.get('other',0)} none={status.get('none',0)}")
    print(f"[validate] lang: en={lang.get('en',0)} fr={lang.get('fr',0)} unknown={lang.get('unknown',0)}")
    print(f"[validate] pairs: total_pairs={pairs.get('total_pairs',0)} missing_fr_total={pairs.get('missing_fr_total',0)} missing_fr_key={pairs.get('missing_fr_key',0)} missing_en_total={pairs.get('missing_en_total',0)}")

    # Show top P0/P1 missing FR
    rows = d.get("pairs_sample", [])
    p01 = [r for r in rows if r.get("status") == "missing_fr" and r.get("priority") in ("P0","P1")]
    p01 = p01[:15]
    if p01:
        print("\n[validate] TOP missing FR (P0/P1):")
        for r in p01:
            print(f"  {r.get('priority')} {r.get('key_type','-'):>8} {r.get('path')} -> {r.get('en_url')}")
    else:
        print("\n[validate] No P0/P1 missing FR detected.")

    # Hard verdict
    missing_key = int(pairs.get("missing_fr_key", 0) or 0)
    fr_pages = int(lang.get("fr", 0) or 0)
    if fr_pages == 0:
        verdict = "FAIL (no French pages found)"
    elif missing_key > 0:
        verdict = f"FAIL ({missing_key} key pages missing French)"
    else:
        verdict = "PASS (key pages covered)"
    print(f"\n[validate] VERDICT: {verdict}")

if __name__ == "__main__":
    main()
